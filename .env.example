# SecureFast Configuration (copy to .env to customize)

# Zero-Knowledge Relay ("The Path")
SF_RELAY_HOST=0.0.0.0
SF_RELAY_PORT=8765
SF_MAX_CHUNK_BYTES=2048
SF_PATH_TTL_SECONDS=900
SF_OFFLINE_QUEUE_TTL_SECONDS=86400
SF_RATE_LIMIT_MAX=2000
SF_RATE_LIMIT_WINDOW=60
SF_CORS_ORIGINS=*

# Local Device Client
SF_CLIENT_HOST=127.0.0.1
SF_CLIENT_PORT=8000
SF_RELAY_URL=ws://127.0.0.1:8765
SF_USERNAME=
SF_ROLE=ADMIN
